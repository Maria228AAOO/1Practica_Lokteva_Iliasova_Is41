<Window x:Class="практика2часть.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:практика2часть"
        mc:Ignorable="d"
        Title="Window1" Height="500" Width="380">
    <Grid>
    <Border Background="White" CornerRadius="8" Width="360" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Direction="270" RenderingBias="Quality" ShadowDepth="2" Opacity="0.15"/>
            </Border.Effect>
            
            <StackPanel>
                <!-- Заголовок -->
                <TextBlock Text="Вход в систему" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,25" Foreground="#222222"/>

                <!-- Поля ввода -->
                <TextBlock Text="Логин *:" Margin="0,5,0,4" FontSize="14" FontWeight="SemiBold" Foreground="#555555"/>
                <TextBox x:Name="TxtLogin" Padding="8" FontSize="14" Margin="0,0,0,12"/>

                <TextBlock Text="Пароль *:" Margin="0,5,0,4" FontSize="14" FontWeight="SemiBold" Foreground="#555555"/>
                <PasswordBox x:Name="TxtPassword" Padding="8" FontSize="14" Margin="0,0,0,20"/>

                <!-- Капча (Изначально скрыта) -->
                <TextBlock x:Name="LblCaptcha" Text="Соберите пазл для проверки *:" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,10" Visibility="Collapsed" Foreground="#555555"/>
                
                <!-- Идеальный квадратный пазл 2х2 -->
                <UniformGrid x:Name="PnlPuzzle" Columns="2" Rows="2" Width="140" Height="140" HorizontalAlignment="Center" Margin="0,0,0,20" Visibility="Collapsed">
                    <Image x:Name="ImgPart1" Source="3.png" Stretch="Fill" Margin="0" Cursor="Hand" MouseDown="ImgPart_MouseDown"/>
                    <Image Grid.Column="1" x:Name="ImgPart2" Source="1.png" Stretch="Fill" Margin="0" Cursor="Hand" MouseDown="ImgPart_MouseDown"/>
                    <Image x:Name="ImgPart3" Source="4.png" Stretch="Fill" Margin="0" Cursor="Hand" MouseDown="ImgPart_MouseDown"/>
                    <Image Grid.Column="3" x:Name="ImgPart4" Source="2.png" Stretch="Fill" Margin="0" Cursor="Hand" MouseDown="ImgPart_MouseDown"/>
                </UniformGrid>

                <!-- Интерактивная кнопка БЕЗ ГОЛУБОГО ЦВЕТА -->
                <Button Content="Войти в систему" Foreground="White" FontSize="16" FontWeight="Bold" Padding="12" x:Name="BtnLogin" Click="BtnLogin_Click" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#2E7D32"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <!-- Полностью переписываем отображение, чтобы убить стандартный голубой цвет Windows -->
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <!-- Наведение: сочный темно-изумрудный цвет -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1B5E20"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
