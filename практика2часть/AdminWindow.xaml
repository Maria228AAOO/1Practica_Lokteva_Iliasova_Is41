<Window x:Class="практика2часть.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:практика2часть"
        mc:Ignorable="d"
         Title="Панель Администратора" Height="450" Width="600" Background="#1E272C">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель управления -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,0,0,10">
            <Button Name="BtnBackToLogin" Content="🚪 Назад на вход" Click="BtnBackToLogin_Click" Width="120" Background="#D32F2F" Foreground="White" FontWeight="Bold" Padding="5"/>
            <TextBlock Text=" Системный лог пользователей из MySQL" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Таблица вывода пользователей из базы данных -->
        <DataGrid Name="DgUsers" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True" 
                  GridLinesVisibility="Horizontal" Background="#2E7D32" RowBackground="#37474F" 
                  Foreground="White" AlternatingRowBackground="#1E272C"/>

        <!-- Нижняя панель действий (Добавление и разблокировка) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <StackPanel Margin="5">
                <TextBlock Text="Логин:" Foreground="White"/>
                <TextBox Name="TxtNewLogin" Width="100"/>
            </StackPanel>
            <StackPanel Margin="5">
                <TextBlock Text="Пароль:" Foreground="White"/>
                <TextBox Name="TxtNewPassword" Width="100"/>
            </StackPanel>
            <StackPanel Margin="5">
                <TextBlock Text="Роль:" Foreground="White"/>
                <ComboBox Name="CmbRole" Width="100">
                    <ComboBoxItem Content="Администратор"/>
                    <ComboBoxItem Content="Пользователь"/>
                </ComboBox>
            </StackPanel>
            <Button Name="BtnAddUser" Content="➕ Добавить" Click="BtnAddUser_Click" Width="80" Height="25" Margin="5,15,5,5" Background="#2E7D32" Foreground="White"/>

            <StackPanel Margin="20,5,5,5">
                <TextBlock Text="Логин для разблокировки:" Foreground="White"/>
                <TextBox Name="TxtUnlockLogin" Width="100"/>
            </StackPanel>
            <Button Name="BtnUnlock" Content="🔓 Снять блок" Click="BtnUnlock_Click" Width="95" Height="25" Margin="5,15,5,5" Background="#0288D1" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>